POSTGRES_DB=pos
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
DATABASE_URL=postgresql+psycopg://pos:pos@db:5432/pos
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000

# Alegra electronic invoicing (Colombia). Disabled unless explicitly enabled.
# Get the email/token from Alegra: Configuración > API - Integraciones con otros sistemas.
# ALEGRA_NUMBER_TEMPLATE_ID must be the id of an existing, isElectronic=true
# number template from GET /number-templates?documentType=invoice — the POS
# never creates a numbering scheme itself.
ALEGRA_ENABLED=false
ALEGRA_API_URL=https://api.alegra.com/api/v1
ALEGRA_EMAIL=
ALEGRA_TOKEN=
ALEGRA_NUMBER_TEMPLATE_ID=

# Automatic issue after checkout (background; never blocks/reverts the sale). OFF by default:
# turning it on creates REAL invoices in Alegra. _STAMP=true also asks Alegra to send them to DIAN.
ALEGRA_AUTO_ISSUE=false
ALEGRA_AUTO_ISSUE_STAMP=false
# Optional: Alegra id of CONSUMIDOR FINAL. Empty = resolved from synced customers / identification 222222222222.
ALEGRA_FINAL_CONSUMER_CONTACT_ID=
# Generic Alegra items for manual sales without a catalog product (empty = those sales stay BLOCKED).
ALEGRA_ITEM_MANUAL_BULK=372
ALEGRA_ITEM_MANUAL_SACK=
# POS -> Alegra catalog: item creation stays OFF (three barriers: this flag, dry_run, batch limit).
ALEGRA_CATALOG_CREATE_ENABLED=false
ALEGRA_CATALOG_BATCH_LIMIT=50
